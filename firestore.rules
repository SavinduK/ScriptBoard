rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidClipboardItem(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.originDeviceId is string && data.originDeviceId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 500000 &&
             data.isImage is bool &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidDevice(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.deviceId is string && data.deviceId.size() <= 128 &&
             data.deviceName is string && data.deviceName.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /devices/{devId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(devId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'deviceId', 'deviceName', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'deviceId', 'deviceName', 'createdAt', 'updatedAt']) &&
                         isValidDevice(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(devId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().deviceId == existing().deviceId &&
                         isValidDevice(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(devId);
      }

      match /clipboard_items/{clipId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(clipId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'originDeviceId', 'title', 'content', 'isImage', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'originDeviceId', 'title', 'content', 'isPinned', 'category', 'isImage', 'mimeType', 'createdAt', 'updatedAt']) &&
                         isValidClipboardItem(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(clipId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().originDeviceId == existing().originDeviceId &&
                         isValidClipboardItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'isPinned', 'category', 'isImage', 'mimeType', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(clipId);
      }
    }
  }
}
